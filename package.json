{
  "name": "sheetdock",
  "version": "1.0.0",
  "private": true,
  "description": "Excel用ワークシート一覧タスクペイン",
  "engines": {
    "node": ">=24 <25"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "test": "vitest run",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs": "office-addin-dev-certs install",
    "sideload": "office-addin-debugging start manifest.xml --no-debug",
    "stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/office-js": "^1.0.377",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^27.4.0",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^3.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  }
}
