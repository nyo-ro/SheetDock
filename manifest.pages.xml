<?xml version="1.0" encoding="utf-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>4e8952c2-160e-41ac-91a7-0469ab02c117</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>SheetDock</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="SheetDock" />
  <Description DefaultValue="Excelのワークシート一覧・切り替え・名前検索" />
  <IconUrl DefaultValue="https://nyo-ro.github.io/SheetDock/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://nyo-ro.github.io/SheetDock/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://nyo-ro.github.io/SheetDock/help.html" />
  <AppDomains>
    <AppDomain>https://nyo-ro.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.17">
      <Set Name="ExcelApi" MinVersion="1.17" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://nyo-ro.github.io/SheetDock/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="SheetDock.Group">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="SheetDock.Open">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>SheetDock.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://nyo-ro.github.io/SheetDock/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://nyo-ro.github.io/SheetDock/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://nyo-ro.github.io/SheetDock/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://nyo-ro.github.io/SheetDock/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://nyo-ro.github.io/SheetDock/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CommandsGroup.Label" DefaultValue="SheetDock" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="SheetDockを開く" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="ワークシート一覧からシートを切り替えます。" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
